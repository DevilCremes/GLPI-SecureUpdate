{% if not fragment %}
<link rel="stylesheet" href="{{ css_url }}">
{% if js_url %}<script src="{{ js_url }}" defer></script>{% endif %}
<main class="gu">
<aside class="gu-rail"><div class="gu-brand"><b>GLPI</b><strong>SecureUpdate</strong></div>
<nav class="gu-nav" aria-label="Seções do SecureUpdate">{% for link in nav %}<a href="{{ link.url }}" {% if link.id == tab %}aria-current="page"{% endif %}>{{ link.label }}</a>{% endfor %}</nav>
<span class="gu-admin">Super-Admin</span></aside>
<div class="gu-main"><p class="gu-path">Configurar / SecureUpdate</p>
<h1>{{ page_title }}</h1>
{% if tab in ['atualizacao','backups'] %}
<section class="gu-monitor" {% if not watch %}hidden{% endif %} data-url="{{ panel_url }}?andamento=1" aria-label="Andamento da operação">
    <div class="gu-monitor-head"><strong role="status">{{ phase|default('Conectando ao executor') }}</strong><span class="gu-meter-text"></span></div>
    <progress aria-label="Progresso da operação"></progress>
    <p class="gu-request-feedback" role="alert" hidden></p>
    <p class="gu-connection" role="status" hidden></p>
    <details open><summary>Console da operação</summary><ol role="log" aria-label="Eventos da operação"></ol></details>
    <noscript><a href="{{ panel_url }}?aba={{ tab }}">Consultar andamento</a></noscript>
</section>
{% endif %}
{% endif %}
<div class="gu-results" data-tab="{{ tab }}" data-job="{{ job }}" data-busy="{{ busy ? '1' : '0' }}">
{% if msg %}<p class="gu-msg" role="status">{{ msg }}</p>{% endif %}
{% if error %}<p class="gu-error alert alert-danger" role="alert">{{ error }}</p>{% endif %}
{% if tab == 'atualizacao' %}
<dl class="gu-strip" aria-label="Comparação de versões">
    <div><dt>Versão instalada</dt><dd>{{ installed }}</dd></div>
    <div><dt>Versão disponível</dt><dd>{% if available %}{{ target }}{% else %}—{% endif %}</dd></div>
    <div><dt>Urgência</dt><dd>{% if available %}<span class="gu-badge" data-level="{{ urgency|lower }}">{{ urgency }}</span>{% else %}—{% endif %}</dd></div>
</dl>
<div class="gu-ledger">
<h2 class="gu-ledger-title">Pacote e aprovação</h2>
<div class="gu-split"><nav class="gu-index" aria-label="Pacote e aprovação" hidden></nav>
<div class="gu-inspector">
<section class="gu-pane" id="gu-versao" data-label="Resumo da versão">
<h2>Resumo da versão</h2>
{% if available %}
        <dl class="gu-summary">
            <div><dt>Ramo</dt><dd>{{ major }}.0{% if migration %} → {{ major + 1 }}.0{% endif %}</dd></div>
            <div><dt>Pacote</dt><dd>glpi-{{ target }}.tgz</dd></div>
            <div><dt>Origem</dt><dd>{% if prepared.source|default('') == 'upload' %}Arquivo enviado do computador{% elseif prepared.source|default('') == 'download' %}Baixado pelo servidor{% else %}Release oficial do GLPI{% endif %}</dd></div>
        </dl>
        <h2>Changelog</h2>
        {% for note in notes %}
        <details class="gu-note" {% if loop.first %}open{% endif %}><summary>GLPI {{ note.version }}</summary>
            <div class="gu-notes">{{ note.body }}</div><a href="{{ note.url }}" rel="noopener noreferrer">Abrir notas oficiais ↗</a>
        </details>{% endfor %}
{% elseif checked %}<p>{% if migration %}Nenhuma versão estável disponível no ramo {{ major + 1 }}.0.{% else %}O GLPI está atualizado no ramo {{ major }}.0.{% endif %}</p>{% elseif connected %}<p>Aguardando a primeira consulta de versões.</p>{% endif %}<div class="gu-check">{% if checked %}<small>Última consulta em {{ checked }}</small>{% endif %}
{% if connected and not busy %}<form method="post"><input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}"><input type="hidden" name="approval_token" value="{{ token }}"><input type="hidden" name="op" value="check">{% if major < 12 %}
<label>Ramo de destino <select name="scope"><option value="same">Manutenção · {{ major }}.0</option><option value="next"{% if migration %} selected{% endif %}>Migração · {{ major + 1 }}.0</option></select></label>
{% endif %}<button class="btn">Consultar versões</button></form>{% endif %}</div>
</section>
{% if available %}<section class="gu-pane" id="gu-pacote" data-label="Verificação e aprovação">
<h2>Verificação e aprovação</h2>
<div class="gu-package">
        {% if can_prepare %}
        <fieldset class="gu-picker"><legend>Origem do pacote</legend>
            <div class="gu-segments">
                <label><input type="radio" name="package_source" value="download" {% if selected_source != 'upload' %}checked{% endif %}><span>Baixar pelo servidor</span></label>
                <label><input type="radio" name="package_source" value="upload" {% if selected_source == 'upload' %}checked{% endif %}><span>Enviar do computador</span></label>
            </div>
        </fieldset>
        {% for source in ['download','upload'] %}
        <div class="gu-source" data-source="{{ source }}">
            {% if can_apply and prepared.source == source %}
            <details class="gu-proof"><summary>SHA-256 verificado</summary>
                <p>{{ prepared.size }} bytes</p><code>{{ prepared.sha }}</code>
            </details>
            <form class="gu-approval" method="post">
                <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}"><input type="hidden" name="approval_token" value="{{ token }}"><input type="hidden" name="op" value="apply"><input type="hidden" name="ref" value="{{ prepared.id }}">
                <label class="gu-choice"><input class="form-check-input" type="checkbox" name="confirm" value="yes" required><span>Autorizo {% if migration %}a migração{% else %}a atualização{% endif %} de {{ installed }} para {{ target }} e o rollback em caso de falha antes da reabertura.</span></label>
                <button class="btn btn-primary" type="submit" disabled>Aprovar atualização</button>
                <noscript><button class="btn" type="submit">Confirmar autorização e atualizar</button></noscript>
            </form>
            <details class="gu-note"><summary>Verificar outro pacote</summary>
            {% endif %}
            {% if source == 'upload' %}
            <p><a href="{{ asset_url }}" rel="noopener noreferrer">Baixar o .tgz oficial do GLPI {{ target }}</a></p>
            <form method="post" enctype="multipart/form-data">
                <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}"><input type="hidden" name="approval_token" value="{{ token }}"><input type="hidden" name="op" value="upload"><input type="hidden" name="ref" value="{{ ref }}">
                <label>Arquivo compactado (.tgz)<input class="form-control" type="file" name="package" accept=".tgz,.tar.gz" required></label>
                <button class="btn" type="submit">Enviar e verificar arquivo</button>
            </form>
            {% else %}
            <p>O servidor compara o pacote com o SHA-256 da release oficial antes de liberar a aprovação.</p>
            <form method="post"><input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}"><input type="hidden" name="approval_token" value="{{ token }}"><input type="hidden" name="op" value="download"><input type="hidden" name="ref" value="{{ ref }}"><button class="btn" type="submit">Baixar e verificar pacote</button></form>
            {% endif %}
            {% if can_apply and prepared.source == source %}</details>{% endif %}
        </div>
        {% endfor %}
        {% elseif busy %}<p>Aguarde a conclusão da operação para preparar outro pacote.</p>
        {% else %}<p>Consulte as versões novamente para preparar o pacote.</p>{% endif %}
</div>
</section>
{% endif %}{% if restore and not busy %}<section class="gu-pane" id="gu-rollback" data-label="Rollback">
<h2>Rollback</h2>
<p>Ponto de restauração de {{ backup_time }}. O serviço salva o estado atual antes de reverter. Chamados posteriores ao backup deixarão de aparecer na instalação restaurada.</p><form method="post"><input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}"><input type="hidden" name="approval_token" value="{{ token }}"><input type="hidden" name="op" value="rollback"><input type="hidden" name="ref" value="{{ restore }}"><label class="gu-choice"><input class="form-check-input" type="checkbox" name="confirm" value="yes" required> Autorizo voltar ao ponto indicado.</label><button class="btn">Aprovar rollback</button></form>
</section>
{% endif %}</div></div></div>
{% elseif tab == 'backups' %}
<section class="gu-backups">

{% if connected and vault %}
{% if backup_result %}<p role="status">{{ backup_result.message }} Trabalho <code>{{ backup_result.job }}</code>.</p>{% endif %}
<dl class="gu-strip"><div><dt>Cópias</dt><dd>{{ vault.total }}</dd></div><div><dt>Destino</dt><dd>{% for d in vault.destinations %}{% if d.id == policy.destination %}{{ d.label }}{% endif %}{% endfor %}</dd></div><div><dt>Próximo backup</dt><dd>{{ backup_next|default('Agendamento desativado') }}</dd></div></dl>
<div class="gu-ledger">
<h2 class="gu-ledger-title">Armazenamento e cópias</h2>
<div class="gu-split"><nav class="gu-index" aria-label="Armazenamento e cópias" hidden></nav>
<div class="gu-inspector">
<section class="gu-pane" id="gu-catalogo" data-label="Catálogo de backups">
<h2>Catálogo de backups</h2>
{% for b in backups %}<details class="gu-note"><summary>{{ b.date }} · {{ b.version }} · {{ b.size }} · {{ b.destination }}</summary>
<p><code>{{ b.id }}</code> · {% if b.deleting %}Exclusão incompleta. Confirme a exclusão para tentar novamente.{% elseif b.pending %}Envio pendente. Cópia local preservada.{% else %}Cópia verificada{% endif %}</p>
{% if not busy %}<div class="gu-actions">
{% for action in backup_actions %}{% if not b.deleting and (action.id != 'bretry' or b.pending) %}<form method="post"><input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}"><input type="hidden" name="approval_token" value="{{ token }}"><input type="hidden" name="op" value="{{ action.id }}"><input type="hidden" name="ref" value="{{ b.id }}"><button class="btn">{{ action.label }}</button></form>{% endif %}{% endfor %}
</div>
<details><summary>Restaurar ou excluir</summary><p>Restaurar substitui os dados em uso pelos desta cópia e abre uma janela de manutenção. Excluir remove esta cópia do destino e do catálogo.</p>
<form method="post"><input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}"><input type="hidden" name="approval_token" value="{{ token }}"><input type="hidden" name="ref" value="{{ b.id }}">
<label>Digite o identificador completo <input class="form-control" name="typed" required autocomplete="off"></label>
<button class="btn" type="submit" name="op" value="brestore" {% if b.deleting %}disabled{% endif %}>Restaurar esta cópia</button> <button class="btn" type="submit" name="op" value="bdelete">Excluir esta cópia</button>
</form></details>{% endif %}</details>{% endfor %}
{% if not vault.total %}<p>Ainda não há backups concluídos.</p>{% endif %}
<nav class="gu-actions" aria-label="Páginas do catálogo">{% if offset %}<a href="{{ panel_url }}?aba=backups&amp;offset={{ prev_offset }}">Anterior</a>{% endif %}{% if next_offset < vault.total %}<a href="{{ panel_url }}?aba=backups&amp;offset={{ next_offset }}">Próxima página</a>{% endif %}</nav>
</section>
<section class="gu-pane" id="gu-destinos" data-label="Destinos de backup">
<h2>Destinos de backup</h2>
<dl>{% for d in vault.destinations %}<dt>{{ d.label }} · {{ d.type_label }}</dt><dd><code>{{ d.location }}</code></dd>{% endfor %}</dl>
<p>Cadastre um destino e teste se o executor consegue gravar, ler e excluir um arquivo nele. Depois, selecione o destino em <a href="#gu-politica">Destino, agendamento e retenção</a>.</p>
{% for kind, title in {'local':'Pasta local', 'nas':'NAS (SMB)', 'cloud':'Nuvem (S3)'} %}
<details class="gu-note"><summary>{{ title }}</summary>
<form method="post" autocomplete="off"><fieldset {% if busy %}disabled{% endif %}>
<input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}"><input type="hidden" name="approval_token" value="{{ token }}">
<input type="hidden" name="op" value="bregister"><input type="hidden" name="kind" value="{{ kind }}">
<label>Nome do destino <input class="form-control" name="label" maxlength="80" required></label>
{% if kind == 'local' %}
<label>Diretório base no servidor <select class="form-select" name="base">{% for base in vault.bases %}<option value="{{ base.id }}">{{ base.path }}</option>{% endfor %}</select></label>
<label>Subpasta <input class="form-control" name="folder" placeholder="financeiro/diarios" maxlength="400" required></label>
<small>Subpastas novas são criadas no diretório escolhido. Para outro disco, o administrador Linux pode habilitar uma base adicional.</small>
{% elseif kind == 'nas' %}
<label>Servidor SMB <input class="form-control" name="server" placeholder="nas.exemplo.local" required></label>
<label>Compartilhamento <input class="form-control" name="share" placeholder="Backups" required></label>
<label>Pasta dentro do compartilhamento <input class="form-control" name="folder" placeholder="glpi/producao" maxlength="400"></label>
<label>Usuário do NAS <input class="form-control" name="user" required></label>
<label>Domínio ou grupo de trabalho <input class="form-control" name="domain" placeholder="WORKGROUP"></label>
<label>Senha do NAS <input class="form-control" type="password" name="password" autocomplete="new-password" required></label>
{% else %}
<label>Endpoint HTTPS <input class="form-control" type="url" name="endpoint" placeholder="https://s3.exemplo.com"></label>
<small>Para Amazon S3, deixe o endpoint vazio.</small>
<label>Região <input class="form-control" name="region" placeholder="sa-east-1" required></label>
<label>Bucket <input class="form-control" name="bucket" required></label>
<label>Pasta dentro do bucket <input class="form-control" name="folder" placeholder="glpi/producao" maxlength="400"></label>
<label>Chave de acesso <input class="form-control" name="access_key" required></label>
<label>Chave secreta <input class="form-control" type="password" name="secret_key" autocomplete="new-password" required></label>
{% endif %}
{% if kind != 'local' %}<small>Deixe a pasta vazia para usar a raiz do {% if kind == 'nas' %}compartilhamento{% else %}bucket{% endif %}.</small>{% endif %}
<p><button class="btn btn-primary" name="confirm" value="yes">Testar e cadastrar</button></p>
</fieldset></form></details>
{% endfor %}
</section>
<section class="gu-pane" id="gu-politica" data-label="Destino, agendamento e retenção">
<h2>Destino, agendamento e retenção</h2>
<form method="post" class="gu-bpolicy"><fieldset {% if busy %}disabled{% endif %}>
<input type="hidden" name="op" value="bsave"><input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}"><input type="hidden" name="approval_token" value="{{ token }}">
<label>Salvar em <select class="form-select" name="destination">{% for d in vault.destinations %}<option value="{{ d.id }}" {% if d.id == policy.destination %}selected{% endif %}>{{ d.label }} · {{ d.type_label }} · {{ d.location }}</option>{% endfor %}</select></label>
<small><a href="#gu-destinos">Cadastrar pasta local, NAS ou nuvem</a></small>
<label class="gu-choice"><input class="form-check-input" name="enabled" type="checkbox" {% if policy.rule %}checked{% endif %}> Agendar backups com janela de manutenção</label>
<div class="gu-bcalendar">
<label>Frequência <select class="form-select" name="kind">{% for k in backup_kinds %}<option value="{{ k.id }}" {% if k.id == brule.kind|default('daily') %}selected{% endif %}>{{ k.label }}</option>{% endfor %}</select></label>
<label class="gu-weekday">Dia da semana <select class="form-select" name="weekday">{% for dayname in weekdays %}<option value="{{ loop.index }}" {% if loop.index == brule.weekday|default(1) %}selected{% endif %}>{{ dayname }}</option>{% endfor %}</select></label>
<label class="gu-monthday">Dia do mês <select class="form-select" name="day">{% for d in month_days %}<option value="{{ d }}" {% if d == brule.day|default(1) %}selected{% endif %}>{{ d }}</option>{% endfor %}</select></label>
<label>Horário <input class="form-control" type="time" name="at" value="{{ brule.at|default('02:00') }}"></label>
<label>Fuso horário <select class="form-select" name="zone">{% for tz in zones %}<option {% if tz == backup_zone %}selected{% endif %}>{{ tz }}</option>{% endfor %}</select></label>
</div>
<h3>Retenção</h3>
<label>Manter as cópias mais recentes <input class="form-control" type="number" name="keep" value="{{ policy.keep }}" min="1" max="1000" required></label>
<label>Preservar também as cópias dos últimos dias <input class="form-control" name="days" type="number" min="0" max="3650" value="{{ policy.days }}" required></label>
<label class="gu-choice"><input class="form-check-input" type="checkbox" name="auto" {% if policy.auto %}checked{% endif %}> Limpar cópias fora da retenção após um novo backup bem-sucedido neste destino</label>
<label class="gu-choice"><input class="form-check-input" type="checkbox" name="confirm" value="yes" required> Confirmo o destino, a janela de manutenção e a política de exclusão selecionados.</label>
<button class="btn btn-primary">Salvar política</button></fieldset></form>
</section>
{% if not busy %}<section class="gu-pane" id="gu-operacoes" data-label="Testar destino ou criar backup">
<h2>Testar destino ou criar backup</h2>
{% if not busy %}
<form method="post"><input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}"><input type="hidden" name="approval_token" value="{{ token }}"><input type="hidden" name="op" value="btest">
<label>Testar destino <select class="form-select" name="ref">{% for d in vault.destinations %}<option value="{{ d.id }}" {% if policy.destination == d.id %}selected{% endif %}>{{ d.label }}</option>{% endfor %}</select></label>
<button class="btn">Testar conexão</button></form>
<form method="post"><input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}"><input type="hidden" name="approval_token" value="{{ token }}"><input type="hidden" name="op" value="backup">
<label class="gu-choice"><input class="form-check-input" type="checkbox" name="confirm" value="yes" required> Autorizo entrar em manutenção para copiar o banco, a instalação e os dados externos.</label><button class="btn btn-primary">Criar backup agora</button></form>
{% endif %}
</section>
{% endif %}<section class="gu-pane" id="gu-limpeza" data-label="Prévia da limpeza">
<h2>Prévia da limpeza</h2>
<p>{{ vault.count }} cópia(s) fora da política salva para {{ policy.destination }}.</p>
{% if vault.count %}<ul>{% for key in vault.candidates %}<li><code>{{ key }}</code></li>{% endfor %}</ul>
{% if not busy %}<form method="post"><input type="hidden" name="op" value="bprune"><input type="hidden" name="ref" value="{{ vault.digest }}"><input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}"><input type="hidden" name="approval_token" value="{{ token }}">
<label class="gu-choice"><input class="form-check-input" type="checkbox" name="confirm" value="yes" required> Autorizo excluir todas as {{ vault.count }} cópias da prévia.</label><button class="btn">Aplicar limpeza</button></form>{% endif %}{% endif %}
</section>
</div></div></div>
{% endif %}</section>
{% elseif tab == 'saude' %}
<div class="gu-ledger">
<h2 class="gu-ledger-title">Resultados e cobertura</h2>
<div class="gu-split"><nav class="gu-index" aria-label="Resultados e cobertura" hidden></nav>
<div class="gu-inspector">
<section class="gu-pane" id="gu-verificacoes" data-label="Verificações">
<h2>Verificações</h2>
<p class="gu-credit">Diagnóstico completo de João Paulo S. Costa · <a href="#gu-autoria">Créditos do GLPI Health Check</a></p>
{% if health_rows %}<dl class="gu-summary">{% for row in health_rows %}{% if row.name not in comparison_keys %}<div><dt>{{ row.name }}</dt><dd>{{ row.value }}</dd></div>{% endif %}{% endfor %}</dl>{% else %}<p>Ainda não há resultado de healthcheck disponível.</p>{% endif %}
</section>
{% if has_comparison %}<section class="gu-pane" id="gu-comparacao" data-label="Comparação">
<h2>Comparação</h2>
<dl class="gu-summary">{% for row in health_rows %}{% if row.name in comparison_keys %}<div><dt>{{ row.name }}</dt><dd>{{ row.value }}</dd></div>{% endif %}{% endfor %}</dl>
</section>
{% endif %}<section class="gu-pane" id="gu-autoria" data-label="Origem do diagnóstico">
<h2>Origem do diagnóstico</h2>
<p>O diagnóstico completo e sua pontuação são fornecidos pelo <a href="https://github.com/JoaoPauloSCosta/glpi-health-check">GLPI Health Check</a>, plugin de terceiros de João Paulo S. Costa, licenciado sob a GPLv3 ou posterior. O SecureUpdate compara os resultados e apresenta as regressões.</p>
</section>
</div></div></div>
{% elseif tab == 'notificacoes' and connected %}
<dl class="gu-strip"><div><dt>Consulta</dt><dd>{% if advanced %}Calendário{% else %}{{ hours }} h{% endif %}</dd></div>
<div><dt>Aviso no painel</dt><dd>{% if browser %}Ativo{% else %}Desativado{% endif %}</dd></div>
<div><dt>E-mail de backup</dt><dd>{% if backup_email == 'all' %}Todos{% elseif backup_email == 'issues' %}Erros e avisos{% else %}Desativado{% endif %}</dd></div></dl>
<form method="post" class="gu-schedule">
    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}"><input type="hidden" name="approval_token" value="{{ token }}"><input type="hidden" name="op" value="settings">
<div class="gu-ledger">
<h2 class="gu-ledger-title">Regras e canais</h2>
<div class="gu-split"><nav class="gu-index" aria-label="Regras e canais" hidden></nav>
<div class="gu-inspector">
<section class="gu-pane" id="gu-email-backups" data-label="E-mail sobre backups">
<h2>E-mail sobre backups</h2>
<fieldset aria-label="E-mail sobre backups">
        <label>Enviar aos Super-Admins ativos
            <select class="form-select" name="backup_email">
                <option value="off" {% if backup_email == 'off' %}selected{% endif %}>Desativado</option>
                <option value="issues" {% if backup_email == 'issues' %}selected{% endif %}>Somente erros e avisos</option>
                <option value="all" {% if backup_email == 'all' %}selected{% endif %}>Todos os resultados, incluindo sucessos</option>
            </select>
        </label>
        <small>Inclui backups manuais e agendados, operações do catálogo e cópias de segurança anteriores à atualização ou ao rollback. O e-mail é enviado após o resultado, independentemente do intervalo de consulta de versões.</small>
        {% if backup_mail_pending %}<p role="status">{{ backup_mail_pending }} aviso(s) pendente(s).{% if backup_mail_failed %} Houve falha no envio. O executor tentará novamente.{% endif %}</p>{% endif %}
    </fieldset>
</section>
<section class="gu-pane" id="gu-calendario" data-label="Calendário de consulta">
<h2>Calendário de consulta</h2>
<fieldset><legend>Intervalo de consulta</legend>
        <label class="gu-choice"><input class="form-check-input" type="radio" name="mode" value="simple" {% if not advanced %}checked{% endif %}> Simples</label>
        <label class="gu-choice"><input class="form-check-input" type="radio" name="mode" value="advanced" {% if advanced %}checked{% endif %}> Avançado</label>
    </fieldset>
    <div class="gu-simple">
        <label>Consultar a cada (horas)
            <select class="form-select" name="hours">{% for h in hour_options %}<option value="{{ h }}" {% if hours == h %}selected{% endif %}>{{ h }}</option>{% endfor %}</select>
        </label>
    </div>
    <div class="gu-calendar">
        <label>Repetir
            <select class="form-select" name="kind">
                <option value="daily" {% if kind == 'daily' %}selected{% endif %}>Todos os dias</option>
                <option value="weekly" {% if kind == 'weekly' %}selected{% endif %}>Toda semana</option>
                <option value="first" {% if kind == 'first' %}selected{% endif %}>Primeiro dia de cada mês</option>
                <option value="monthly" {% if kind == 'monthly' %}selected{% endif %}>Dia específico de cada mês</option>
                <option value="last" {% if kind == 'last' %}selected{% endif %}>Último dia de cada mês</option>
            </select>
        </label>
        <label class="gu-weekday">Dia da semana
            <select class="form-select" name="weekday">{% for name in weekdays %}<option value="{{ loop.index }}" {% if weekday == loop.index %}selected{% endif %}>{{ name }}</option>{% endfor %}</select>
        </label>
        <label class="gu-monthday">Dia do mês
            <select class="form-select" name="day">{% for d in month_days %}<option value="{{ d }}" {% if day == d %}selected{% endif %}>{{ d }}</option>{% endfor %}</select>
            <small>Meses sem o dia escolhido são pulados.</small>
        </label>
        <label>Horário <input class="form-control" type="time" name="at" value="{{ at }}"></label>
        <label>Fuso horário <select class="form-select" name="zone">{% for tz in zones %}<option {% if zone == tz %}selected{% endif %}>{{ tz }}</option>{% endfor %}</select></label>
    </div>
    {% if next_check %}<p class="gu-next">Próxima consulta agendada <strong>{{ next_check }}</strong> ({{ zone }})</p>{% endif %}
</section>
<section class="gu-pane" id="gu-canais" data-label="Avisos de atualização">
<h2>Avisos de atualização</h2>
<fieldset><legend>Onde receber</legend>
        <label class="gu-choice"><input class="form-check-input" type="checkbox" name="browser" {% if browser %}checked{% endif %}> Painel do GLPI</label>
        <label class="gu-choice"><input class="form-check-input" type="checkbox" name="email" {% if email %}checked{% endif %}> E-mail dos Super-Admins ativos</label>
    </fieldset>
</section>
</div></div></div>
<button class="btn btn-primary" type="submit">Salvar preferências</button>
</form>
{% elseif tab == 'debug' %}
{% if debug_rows %}<div class="gu-ledger">
<h2 class="gu-ledger-title">Diagnóstico do serviço</h2>
<div class="gu-split"><nav class="gu-index" aria-label="Diagnóstico do serviço" hidden></nav>
<div class="gu-inspector">
<section class="gu-pane" id="gu-trabalho" data-label="Trabalho em andamento">
<h2>Trabalho em andamento</h2>
<dl class="gu-summary">{% for row in debug_rows %}{% if row.name in job_keys %}<div><dt>{{ row.name }}</dt><dd>{{ row.value }}</dd></div>{% endif %}{% endfor %}</dl>
</section>
<section class="gu-pane" id="gu-executor" data-label="Executor">
<h2>Executor</h2>
<dl class="gu-summary">{% for row in debug_rows %}{% if row.name not in job_keys %}<div><dt>{{ row.name }}</dt><dd>{{ row.value }}</dd></div>{% endif %}{% endfor %}</dl>
</section>
<section class="gu-pane" id="gu-relatorio" data-label="Relatório de suporte">
<h2>Relatório de suporte</h2>
<p>Exporte o resumo do executor e o identificador do trabalho para consultar o log correspondente no servidor.</p><a class="btn" href="{{ export_url }}" download>Exportar JSON</a>
</section>
</div></div></div>
{% else %}<p>Confira o serviço <code>glpi-secureupdate.service</code> no servidor.</p>{% endif %}
{% endif %}
</div>
{% if not fragment %}</div></main>{% endif %}
